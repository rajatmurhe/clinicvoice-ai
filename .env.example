# Copy to .env (never committed) and fill in what you need.

# Required for real FAQ answers and transcription. Without it the API still
# runs: blocked messages, greetings and the fallback decision path work, and
# LLM calls fail with a graceful reception handoff message.
GROQ_API_KEY=

# Gemini fallback key for FAQ answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Booking backend. fake = SQLite demo calendar (no Google account needed).
CLINICVOICE_CALENDAR_MODE=fake

# Which clinic config to load from python-agents/clinics/ (default or smilecare).
CLINICVOICE_CLINIC_ID=default

# legacy = the hand written orchestrator (default), graph = the LangGraph path.
CLINICVOICE_ORCHESTRATOR=legacy

# direct = in process tool calls, mcp = calls go through the MCP tool server.
CLINICVOICE_TOOLS=direct

# Optional feature flags, all off by default. See DECISIONS.md for why.
CLINICVOICE_HYBRID_ROUTER=false
CLINICVOICE_COMPLIANCE_REVIEWER=false

# Google Calendar id, used when CLINICVOICE_CALENDAR_MODE=google.
CLINICVOICE_CALENDAR_ID=

# Retrieval confidence threshold for the FAQ fallback decision.
CLINICVOICE_CONFIDENCE_THRESHOLD=0.35

# LLM provider for FAQ answers: groq (default) or gemini.
LLM_PROVIDER=groq

# Optional Langfuse tracing for FAQ retrieval, validation, and model generations.
# Keep disabled until credentials are configured. Never commit real keys.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Questions and generated answers may contain sensitive health information.
# Keep false unless you have an approved Langfuse project and data policy.
LANGFUSE_TRACE_CONTENT=false

# Absolute path to a clinic-managed JSON registry (see README). Missing = fail closed.
CLINICVOICE_PATIENT_REGISTRY=

# Optional local Ollama embedding cache; leave off for cloud voice requests.
CLINICVOICE_SEMANTIC_CACHE=false
